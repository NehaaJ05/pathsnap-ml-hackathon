{
  "version": "member1-v1",
  "feature_columns": [
    "distance_m",
    "fraction_along",
    "segment_length_m",
    "distance_to_start_m",
    "distance_to_end_m",
    "log1p_distance_m",
    "heading_difference_deg",
    "heading_cosine",
    "heading_valid",
    "dt_s",
    "step_distance_m",
    "speed_mps",
    "gap_before",
    "speed_outlier",
    "candidate_rank",
    "candidate_count",
    "is_fallback",
    "start_in_degree",
    "end_out_degree",
    "previous_nearest_available",
    "same_as_previous_nearest",
    "connected_from_previous_nearest",
    "same_weak_component_as_previous"
  ],
  "dtype": "float32",
  "identifier_columns": [
    "partition",
    "trip_id",
    "observation_id",
    "candidate_arc_id"
  ],
  "target": "separate offline reference_labels.csv.gz join; not included in feature files",
  "candidate_config": {
    "radius_m": 50.0,
    "max_candidates": 8,
    "fallback_nearest": true
  },
  "gap_threshold_s": 10.0,
  "label_max_distance_m": 50.0,
  "label_ambiguity_margin_m": 3.0,
  "label_heading_weight": 0.1
}